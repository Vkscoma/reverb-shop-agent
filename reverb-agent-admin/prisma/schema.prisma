generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model ListingRule {
  id          String   @id @default(cuid())
  listingId   String
  name        String
  floorPrice  Int
  targetPrice Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listingId])
  @@index([isActive])
}

model Escalation {
  id             String   @id @default(cuid())
  conversationId String
  listingId      String?
  intent         String
  message        String
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model SyncedListing {
  id        String   @id @default(cuid())
  reverbId  String   @unique
  make      String
  model     String
  amount    String
  status    String
  offersEnabled Boolean  @default(false)
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ReverbConversation {
  id             String          @id @default(cuid())
  reverbId       String          @unique
  listingId      String?
  unread         Boolean         @default(false)
  status         String          @default("unprocessed")
  latestMessage  String?
  lastMessageAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  messages       ReverbMessage[]

  @@index([status])
  @@index([unread])
}

model ReverbMessage {
  id             String             @id @default(cuid())
  reverbId       String             @unique
  conversationId String
  conversation   ReverbConversation @relation(fields: [conversationId], references: [reverbId], onDelete: Cascade)
  senderId       String?
  body           String
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([conversationId])
  @@index([sentAt])
}

model ReverbOffer {
  id        String   @id @default(cuid())
  reverbId  String   @unique
  listingId String?
  amount    String?
  currency  String   @default("USD")
  status    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([status])
}

model SyncRun {
  id                   String    @id @default(cuid())
  status               String
  startedAt            DateTime  @default(now())
  finishedAt           DateTime?
  listingsCount        Int       @default(0)
  conversationsCount   Int       @default(0)
  messagesCount        Int       @default(0)
  offersCount          Int       @default(0)
  actionsPlanned       Int       @default(0)
  actionsSent          Int       @default(0)
  escalationsCreated   Int       @default(0)
  error                String?
  createdAt            DateTime  @default(now())

  @@index([startedAt])
  @@index([status])
}

model ReverbActionAudit {
  id              String   @id @default(cuid())
  action          String
  status          String
  conversationId  String?
  messageId       String?
  offerId         String?
  listingId       String?
  decision        String?
  requestSummary  String?
  responseSummary String?
  error           String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([conversationId, messageId])
  @@index([offerId, decision])
  @@index([createdAt])
}

model AutomationSetting {
  id                String   @id @default("default")
  offerAutoRespond  Boolean  @default(false)
  messageAutoRespond Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
