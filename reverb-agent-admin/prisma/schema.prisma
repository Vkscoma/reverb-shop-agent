generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ListingRule {
  id          String   @id @default(cuid())
  listingId   String
  name        String
  floorPrice  Int
  targetPrice Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([listingId])
  @@index([isActive])
}

model Escalation {
  id             String   @id @default(cuid())
  conversationId String
  listingId      String?
  intent         String
  message        String
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
